{
  "name": "apex-sim",
  "private": true,
  "version": "0.1.0",
  "description": "APEX_SIM — node-beam soft-body driving & racing simulator (C++20 physics core → WASM, Three.js WebGPU)",
  "type": "module",
  "scripts": {
    "core:configure": "cmake --preset native-release -S core",
    "core:build": "cmake --preset native-release -S core && cmake --build build/native-release",
    "core:test": "npm run core:build && ./build/native-release/sbc_tests",
    "wasm:build": "bash tools/build-wasm.sh",
    "core:test:wasm": "npm run wasm:build && node build/wasm-release/sbc_tests.cjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tools/e2e.mjs",
    "bench": "npm run core:build && ./build/native-release/sbc-cli bench --bodies 16 --seconds 5 --threads 4",
    "vehicles:gen": "node tools/vehicle-gen/porsche_911_turbo_991.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "pretendard": "1.3.9",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
