{
  "name": "sunset-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NeonDash — a 3D endless runner built with Vite, TypeScript and Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:standalone": "node scripts/buildStandalone.mjs",
    "check:templates": "esbuild scripts/checkTemplates.ts --bundle --platform=node --format=esm '--define:import.meta.env={\"DEV\":false}' --outfile=node_modules/.cache/check-templates.mjs --log-level=error && node node_modules/.cache/check-templates.mjs",
    "check:meta": "esbuild scripts/checkMeta.ts --bundle --platform=node --format=esm '--define:import.meta.env={\"DEV\":false}' --outfile=node_modules/.cache/check-meta.mjs --log-level=error && node node_modules/.cache/check-meta.mjs",
    "build:app": "node scripts/buildAppStandalone.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.11",
    "@types/three": "^0.169.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
