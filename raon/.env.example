# 서버가 듣는 포트
PORT=3000
# 데이터(SQLite 파일과 매일 백업)가 저장되는 폴더. 호스팅에서는 영구 볼륨 경로로 지정
DATA_DIR=./data
# production 이면 로그인 쿠키에 Secure 가 붙는다 (HTTPS 필수)
NODE_ENV=production
# http 로 시험할 때만 0. 실제 서비스(HTTPS)에서는 지우거나 1
# COOKIE_SECURE=0
# Railway·Fly 같은 프록시 뒤에서 돌 때 1 (로그인 시도 제한이 실제 접속 IP 기준으로 동작)
TRUST_PROXY=1
# 매일 백업을 며칠치 남길지 (0 이면 백업 안 함)
BACKUP_DAYS=14
# 1 이면 데이터가 비어 있을 때 예시 데이터를 넣는다 (시연용)
# SEED_DEMO=1
