{
  "name": "raon-korean",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "라온국어 — 학원 수업 일정·보강·피드백·교재 관리 플랫폼",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/main.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "build:demo": "vite build --mode demo --outDir dist-demo && node scripts/inline-demo.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "seed": "tsx server/seed-cli.ts",
    "test": "tsx --test server/core/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/hahmlet": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "express": "^5.3.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.25.12",
    "sql.js": "^1.15.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  }
}
